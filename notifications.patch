@@ -0,0 +1,62 @@
+package com.twinhearts.app.core.notifications
+
+import dagger.Module
+import dagger.Provides
+import dagger.hilt.InstallIn
+import dagger.hilt.components.SingletonComponent
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.json.JsonElement
+import retrofit2.Retrofit
+import retrofit2.http.Body
+import retrofit2.http.POST
+import javax.inject.Singleton
+
+/**
+ * Why this file exists: the only door from the app to the server's notification routes
+ * (see backend-changes/notifications). The server holds the Firebase service account and does
+ * the real sending; the app only registers its phone token and asks for pushes to the partner.
+ */
+interface NotificationApi {
+
+    /** Saves this phone's FCM token for the signed-in person. */
+    @POST("api/notifications/token")
+    suspend fun registerToken(@Body body: RegisterTokenBody): JsonElement
+
+    /** Forgets this phone's token (log out), so the next person on it gets nothing. */
+    @POST("api/notifications/token/remove")
+    suspend fun removeToken(@Body body: RemoveTokenBody): JsonElement
+
+    /** Pushes one notification to my partner's phone(s). */
+    @POST("api/notifications/send")
+    suspend fun send(@Body body: SendNotificationBody): JsonElement
+}
+
+@Serializable
+data class RegisterTokenBody(
+    val userId: String,
+    val coupleId: String,
+    val role: String,
+    val token: String,
+    val platform: String = "android",
+)
+
+@Serializable
+data class RemoveTokenBody(val userId: String, val token: String)
+
+@Serializable
+data class SendNotificationBody(
+    val coupleId: String,
+    val fromRole: String,
+    val type: String,
+    val title: String? = null,
+    val body: String? = null,
+    val data: Map<String, String> = emptyMap(),
+)
+
+@Module
+@InstallIn(SingletonComponent::class)
+object NotificationModule {
+    @Provides
+    @Singleton
+    fun provideNotificationApi(retrofit: Retrofit): NotificationApi = retrofit.create(NotificationApi::class.java)
+}
