    <string name="fights_act_mirror_title">Mirror Exercise</string>
    <string name="fights_act_mirror_short">One speaks for 2 minutes, the other mirrors back what they heard.</string>
    <string name="fights_act_mirror_how">Sit facing each other. One speaks for 2 minutes uninterrupted about their feelings. The other mirrors back what they heard. Then switch. This builds deep empathy.</string>
    <string name="fights_act_letter_title">Letter Exchange</string>
    <string name="fights_act_letter_short">Write a letter explaining your perspective. Read without interrupting.</string>
    <string name="fights_act_letter_how">Each write a letter explaining your perspective and what you need. Swap and read without interrupting. Understanding grows through words.</string>
    <string name="fights_act_walk_title">Silent Walk</string>
    <string name="fights_act_walk_short">Take a walk holding hands without speaking. Let the silence heal.</string>
    <string name="fights_act_walk_how">Take a 15-minute walk holding hands without speaking. Sometimes physical closeness heals emotional distance.</string>
    <string name="fights_act_appreciation_title">Appreciation Round</string>
    <string name="fights_act_appreciation_short">Take turns saying 3 things you genuinely appreciate about each other.</string>
    <string name="fights_act_appreciation_how">Take turns saying 3 things you genuinely appreciate about each other right now.</string>
    <string name="fights_act_hug_title">20-Second Hug</string>
    <string name="fights_act_hug_short">Hold each other for at least 20 seconds — feel your heartbeats sync.</string>
    <string name="fights_act_hug_how">Research shows a 20-second hug releases oxytocin. Hold each other for at least 20 seconds — feel your heartbeats sync.</string>
    <string name="fights_act_play_title">Play Together</string>
    <string name="fights_act_play_short">Play a simple game (Ludo, cards, etc.). Shared laughter resets tension.</string>
    <string name="fights_act_play_how">Play a simple game (cards, Ludo, anything). Shared laughter is a powerful reset for tension.</string>
    <string name="fights_act_cook_title">Cook Together</string>
    <string name="fights_act_cook_short">Make a simple meal together. Creating something builds teamwork and trust.</string>
    <string name="fights_act_cook_how">Make a simple meal together. Creating something collaboratively rebuilds teamwork and trust.</string>
    <string name="fights_act_whydive_title">3-Why Deep Dive</string>
    <string name="fights_act_whydive_short">Ask \"why?\" three times to understand the real issue.</string>
    <string name="fights_act_whydive_how">Ask \"why does this bother me?\" three times deeper each time. Often the real issue is not what the fight was about.</string>
