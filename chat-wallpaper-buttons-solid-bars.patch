From 54eb2df8c256cdca80f108826b7a3be2cb655dc9 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 29 Oct 2026 19:41:04 +0000
Subject: [PATCH] Chat: pin wallpaper buttons clear of screen edge; solid
 header and typing bar

---
 .../app/feature/chat/ui/ChatComposer.kt       |  6 ++--
 .../app/feature/chat/ui/ChatMedia.kt          | 29 +++++++++++++++----
 .../app/feature/chat/ui/ChatScreen.kt         |  6 ++--
 .../app/feature/chat/ui/ChatStyle.kt          |  8 ++++-
 4 files changed, 37 insertions(+), 12 deletions(-)

diff --git a/app/src/main/java/com/twinhearts/app/feature/chat/ui/ChatComposer.kt b/app/src/main/java/com/twinhearts/app/feature/chat/ui/ChatComposer.kt
index 3d15829..10ced8b 100644
--- a/app/src/main/java/com/twinhearts/app/feature/chat/ui/ChatComposer.kt
+++ b/app/src/main/java/com/twinhearts/app/feature/chat/ui/ChatComposer.kt
@@ -90,7 +90,7 @@ internal fun ReplyBar(message: ChatMessage, partnerName: String, onCancel: () ->
     Row(
         modifier = Modifier
             .fillMaxWidth()
-            .background(ChatStyle.Glass)
+            .background(ChatStyle.Bar)
             .padding(horizontal = TwinTheme.spacing.l, vertical = TwinTheme.spacing.s),
         verticalAlignment = Alignment.CenterVertically,
     ) {
@@ -112,7 +112,7 @@ internal fun EditBar(message: ChatMessage, onCancel: () -> Unit) {
     Row(
         modifier = Modifier
             .fillMaxWidth()
-            .background(ChatStyle.Glass)
+            .background(ChatStyle.Bar)
             .padding(horizontal = TwinTheme.spacing.l, vertical = TwinTheme.spacing.s),
         verticalAlignment = Alignment.CenterVertically,
         horizontalArrangement = Arrangement.spacedBy(TwinTheme.spacing.s),
@@ -147,7 +147,7 @@ internal fun Composer(text: String, recordingSeconds: Int?, editing: Boolean, ac
             .fillMaxWidth()
             // Same grey glass bar as the chat header on top; the background is drawn first so it
             // also covers the area behind the gesture bar.
-            .background(ChatStyle.Glass)
+            .background(ChatStyle.Bar)
             .border(1.dp, colors.lineSoft)
             .navigationBarsPadding()
             .padding(horizontal = TwinTheme.spacing.s, vertical = TwinTheme.spacing.s),
diff --git a/app/src/main/java/com/twinhearts/app/feature/chat/ui/ChatMedia.kt b/app/src/main/java/com/twinhearts/app/feature/chat/ui/ChatMedia.kt
index ecd714f..8e680a8 100644
--- a/app/src/main/java/com/twinhearts/app/feature/chat/ui/ChatMedia.kt
+++ b/app/src/main/java/com/twinhearts/app/feature/chat/ui/ChatMedia.kt
@@ -23,7 +23,6 @@ import androidx.compose.foundation.layout.padding
 import androidx.compose.foundation.layout.requiredSize
 import androidx.compose.foundation.layout.size
 import androidx.compose.foundation.layout.statusBarsPadding
-import androidx.compose.foundation.layout.navigationBarsPadding
 import androidx.compose.foundation.lazy.LazyColumn
 import androidx.compose.foundation.lazy.grid.GridCells
 import androidx.compose.foundation.lazy.grid.LazyVerticalGrid
@@ -106,6 +105,9 @@ import kotlin.math.roundToInt
 private val SharedCell = 4.dp
 private val SwatchSize = 56.dp
 private val PreviewHeight = 220.dp
+
+/** Empty space kept under the wallpaper buttons (on top of the system bar) so they are never cut off. */
+private val SheetBottomGap = 28.dp
 private const val SHARED_COLUMNS = 3
 private const val DOUBLE_TAP_ZOOM = 2.5f
 private const val MAX_ZOOM = 4f
@@ -375,8 +377,9 @@ internal fun WallpaperScreen(
                 },
             )
         } else {
+            Column(Modifier.fillMaxSize()) {
             Column(
-                modifier = Modifier.fillMaxSize().navigationBarsPadding().verticalScroll(rememberScrollState())
+                modifier = Modifier.weight(1f).fillMaxWidth().verticalScroll(rememberScrollState())
                     .padding(horizontal = TwinTheme.spacing.screenEdge),
                 verticalArrangement = Arrangement.spacedBy(TwinTheme.spacing.m),
             ) {
@@ -397,7 +400,7 @@ internal fun WallpaperScreen(
                                 stringResource(R.string.chat_wallpaper_sample_mine),
                                 color = colors.ink,
                                 style = MaterialTheme.typography.bodyMedium,
-                                modifier = Modifier.clip(TwinTheme.shapes.small).background(colors.primaryBrush).padding(TwinTheme.spacing.s),
+                                modifier = Modifier.clip(TwinTheme.shapes.small).background(ChatStyle.SentBubble).padding(TwinTheme.spacing.s),
                             )
                         }
                     }
@@ -436,6 +439,14 @@ internal fun WallpaperScreen(
                     Text(stringResource(R.string.chat_wallpaper_shared), style = MaterialTheme.typography.bodyLarge, color = colors.ink, modifier = Modifier.weight(1f))
                     PillSwitch(checked = both, onCheckedChange = { both = it })
                 }
+            }
+            // Save and Reset stay pinned at the bottom (they used to scroll away under the screen edge).
+            Column(
+                modifier = Modifier.fillMaxWidth()
+                    .padding(horizontal = TwinTheme.spacing.screenEdge)
+                    .padding(top = TwinTheme.spacing.s, bottom = SheetBottomGap),
+                verticalArrangement = Arrangement.spacedBy(TwinTheme.spacing.s),
+            ) {
                 GlassButton(
                     text = stringResource(R.string.chat_wallpaper_save),
                     onClick = {
@@ -454,6 +465,7 @@ internal fun WallpaperScreen(
                     modifier = Modifier.fillMaxWidth(),
                 )
             }
+            }
         }
     }
 }
@@ -505,7 +517,10 @@ private fun WallpaperCutter(
         }
     }
     val density = LocalDensity.current
-    Column(Modifier.fillMaxSize().navigationBarsPadding().padding(TwinTheme.spacing.screenEdge), verticalArrangement = Arrangement.spacedBy(TwinTheme.spacing.m)) {
+    Column(
+        Modifier.fillMaxSize().padding(start = TwinTheme.spacing.screenEdge, end = TwinTheme.spacing.screenEdge, top = TwinTheme.spacing.screenEdge),
+        verticalArrangement = Arrangement.spacedBy(TwinTheme.spacing.m),
+    ) {
         Text(stringResource(R.string.chat_wallpaper_crop_hint), style = MaterialTheme.typography.bodyMedium, color = colors.inkMuted)
         Box(
             Modifier
@@ -539,7 +554,11 @@ private fun WallpaperCutter(
                 )
             }
         }
-        Row(horizontalArrangement = Arrangement.spacedBy(TwinTheme.spacing.s)) {
+        Row(
+            // Extra gap under the buttons so the gesture bar / screen edge never covers them.
+            modifier = Modifier.padding(bottom = SheetBottomGap),
+            horizontalArrangement = Arrangement.spacedBy(TwinTheme.spacing.s),
+        ) {
             GlassButton(
                 text = stringResource(R.string.chat_cancel),
                 onClick = { onDone(null) },
diff --git a/app/src/main/java/com/twinhearts/app/feature/chat/ui/ChatScreen.kt b/app/src/main/java/com/twinhearts/app/feature/chat/ui/ChatScreen.kt
index 068137d..6390d01 100644
--- a/app/src/main/java/com/twinhearts/app/feature/chat/ui/ChatScreen.kt
+++ b/app/src/main/java/com/twinhearts/app/feature/chat/ui/ChatScreen.kt
@@ -724,7 +724,7 @@ private fun ChatHeader(partnerName: String, state: ChatUiState, actions: ChatAct
     Row(
         modifier = Modifier
             .fillMaxWidth()
-            .background(ChatStyle.Glass)
+            .background(ChatStyle.Bar)
             .border(1.dp, colors.lineSoft)
             .statusBarsPadding()
             .padding(horizontal = TwinTheme.spacing.xs, vertical = TwinTheme.spacing.s),
@@ -858,7 +858,7 @@ private fun SelectionBar(state: ChatUiState, actions: ChatActions) {
     Row(
         modifier = Modifier
             .fillMaxWidth()
-            .background(ChatStyle.Glass)
+            .background(ChatStyle.Bar)
             .border(1.dp, colors.lineSoft)
             .statusBarsPadding()
             .padding(horizontal = TwinTheme.spacing.xs, vertical = TwinTheme.spacing.s),
@@ -880,7 +880,7 @@ private fun PinnedBar(message: ChatMessage, count: Int, actions: ChatActions) {
     Row(
         modifier = Modifier
             .fillMaxWidth()
-            .background(ChatStyle.Glass)
+            .background(ChatStyle.Bar)
             .clickable { actions.onPinnedTap(message.id) }
             .padding(horizontal = TwinTheme.spacing.l, vertical = TwinTheme.spacing.s),
         verticalAlignment = Alignment.CenterVertically,
diff --git a/app/src/main/java/com/twinhearts/app/feature/chat/ui/ChatStyle.kt b/app/src/main/java/com/twinhearts/app/feature/chat/ui/ChatStyle.kt
index 202e6ac..8e44f7f 100644
--- a/app/src/main/java/com/twinhearts/app/feature/chat/ui/ChatStyle.kt
+++ b/app/src/main/java/com/twinhearts/app/feature/chat/ui/ChatStyle.kt
@@ -15,8 +15,14 @@ internal object ChatStyle {
     /** Bars, pills and buttons: white glass instead of pink-tinted glass. */
     val Glass = Color.White.copy(alpha = 0.08f)
 
+    /**
+     * Header, pinned / selection bar and the typing bar: SOLID dark grey. They used to be see-through
+     * white glass, which let a photo wallpaper show through them. (Same look as 8% white on [Base].)
+     */
+    val Bar = Color(0xFF1E1E20)
+
     /** The message box itself: a touch lighter grey than the bar around it, so it reads as a field. */
-    val Field = Color.White.copy(alpha = 0.11f)
+    val Field = Color(0xFF2C2C30)
 
     /** Call history: green for a call that was picked up, red for a missed one. */
     val CallOk = Color(0xFF22C55E)
-- 
2.43.0

