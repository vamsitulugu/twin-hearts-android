From 915865438a372ff5b6e03987e112d5a37d001412 Mon Sep 17 00:00:00 2001
From: claude <claude@example.com>
Date: Sat, 31 Oct 2026 07:20:19 +0000
Subject: [PATCH] Pro: add No Ads feature to plan cards

---
 app/src/main/java/com/twinhearts/app/feature/pro/ProScreen.kt | 2 ++
 app/src/main/res/values/strings_pro.xml                       | 2 ++
 2 files changed, 4 insertions(+)

diff --git a/app/src/main/java/com/twinhearts/app/feature/pro/ProScreen.kt b/app/src/main/java/com/twinhearts/app/feature/pro/ProScreen.kt
index 526d342..79afd44 100644
--- a/app/src/main/java/com/twinhearts/app/feature/pro/ProScreen.kt
+++ b/app/src/main/java/com/twinhearts/app/feature/pro/ProScreen.kt
@@ -29,6 +29,7 @@ import androidx.compose.material.icons.outlined.CardGiftcard
 import androidx.compose.material.icons.outlined.CloudUpload
 import androidx.compose.material.icons.outlined.LibraryMusic
 import androidx.compose.material.icons.outlined.Public
+import androidx.compose.material.icons.outlined.VerifiedUser
 import androidx.compose.material.icons.outlined.WorkspacePremium
 import androidx.compose.material.icons.rounded.ArrowForward
 import androidx.compose.material3.CircularProgressIndicator
@@ -327,6 +328,7 @@ private fun PlanCard(
             FeatureLine(Icons.Outlined.Public, R.string.pro_f_globe, R.string.pro_f_globe_d)
             FeatureLine(Icons.Outlined.LibraryMusic, R.string.pro_f_music, R.string.pro_f_music_d)
             FeatureLine(Icons.Outlined.CloudUpload, R.string.pro_f_movie, R.string.pro_f_movie_d)
+            FeatureLine(Icons.Outlined.VerifiedUser, R.string.pro_f_noads, R.string.pro_f_noads_d)
         }
 
         val enabled = !lifetimeOwned && !busy
diff --git a/app/src/main/res/values/strings_pro.xml b/app/src/main/res/values/strings_pro.xml
index 159ec0c..ec86e4d 100644
--- a/app/src/main/res/values/strings_pro.xml
+++ b/app/src/main/res/values/strings_pro.xml
@@ -51,6 +51,8 @@
     <string name="pro_f_music_d">Build your own shared library and playlists.</string>
     <string name="pro_f_movie">Watch Together · Cloud upload</string>
     <string name="pro_f_movie_d">Upload a movie once and stream it in sync.</string>
+    <string name="pro_f_noads">No Ads</string>
+    <string name="pro_f_noads_d">Enjoy Twin Hearts without any ads.</string>
     <string name="pro_free_note">Chat, calls, Live Map, Vault, Calendar and the rest stay free.\nYour memories, songs and movies are never deleted if Pro ends.</string>
 
     <string name="pro_history">Payment history</string>
-- 
